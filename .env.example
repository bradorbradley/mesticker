# ===== MeSticker Environment Variables =====

# OpenAI — for image generation / style transfer
# Uses gpt-image-1-5 (preview: quality low, print: quality high)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Printful — for sticker fulfillment
# Create an API store and get token at: https://www.printful.com/dashboard/developer
PRINTFUL_ACCESS_TOKEN=
PRINTFUL_STORE_ID=

# Stripe — for payments
# Get keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Image Storage — for storing generated images (Vercel Blob)
# Auto-configured on Vercel, or set manually
BLOB_READ_WRITE_TOKEN=

# Database — Neon Postgres (or Vercel Postgres)
# Create a database at https://neon.tech and copy the connection string
DATABASE_URL=

# Auth — NextAuth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth — for user sign-in (optional — app works without login)
# Set up at: https://console.cloud.google.com/apis/credentials
# Redirect URI: https://your-domain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# App URL — base URL for the app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostHog — analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Email Capture — Resend (free tier, optional)
# Sign up at https://resend.com, create an audience, get API key
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Alerts — for spend/error notifications
# For Telegram: use https://api.telegram.org/bot<BOT_TOKEN>/sendMessage
# ALERT_CHAT_ID is your Telegram chat ID
ALERT_WEBHOOK_URL=
ALERT_CHAT_ID=
