# ===== MeSticker Environment Variables =====

# Google Gemini API — for image generation / style transfer
# Get your key at: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# remove.bg — for background removal
# Get your key at: https://www.remove.bg/api
REMOVEBG_API_KEY=

# Printful — for sticker fulfillment
# Create an API store and get token at: https://www.printful.com/dashboard/developer
PRINTFUL_ACCESS_TOKEN=
PRINTFUL_STORE_ID=

# Stripe — for payments
# Get keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Image Storage — for storing generated images (Vercel Blob)
# Auto-configured on Vercel, or set manually
BLOB_READ_WRITE_TOKEN=

# App URL — base URL for the app
NEXT_PUBLIC_APP_URL=http://localhost:3000
