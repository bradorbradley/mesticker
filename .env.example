# ===== MeSticker Environment Variables =====

# OpenAI — for image generation / style transfer
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI image model (gpt-image-1 is retired). Falls back automatically
# to gpt-image-2.5-flare → gpt-image-2.5-sunburst → gpt-image-2 if unavailable.
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# Printful — for sticker fulfillment
# Create an API store and get token at: https://www.printful.com/dashboard/developer
PRINTFUL_ACCESS_TOKEN=
PRINTFUL_STORE_ID=

# Override the variant ID used for individual 3"x3" kiss-cut stickers if your
# Printful store uses a different variant. Default: 10163 (3" white kiss-cut).
PRINTFUL_VARIANT_INDIVIDUAL_3X3=

# remove.bg — optional safety net for transparent backgrounds.
# If set, every generated image is post-processed through remove.bg
# to guarantee a clean alpha channel before printing.
REMOVEBG_API_KEY=

# Stripe — for payments
# Get keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Image Storage — for storing generated images (Vercel Blob)
# Auto-configured on Vercel, or set manually
BLOB_READ_WRITE_TOKEN=

# Database — Neon Postgres (or Vercel Postgres)
DATABASE_URL=

# Auth — NextAuth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostHog — analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Email Capture — Resend (optional)
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Alerts — for spend/error notifications
ALERT_WEBHOOK_URL=
ALERT_CHAT_ID=

# Optional soft paywall: free generations before a purchase is required.
# Unset or 0 = unlimited (good for demos / kiosk mode).
NEXT_PUBLIC_FREE_GENERATION_LIMIT=

# ===== Booth (/booth — landscape kiosk for the in-person photo booth) =====
# Menu prices in cents (defaults: Sticker Sheet $20, Pose Pack $25, Style Pack $25, Party Pack $40).
NEXT_PUBLIC_BOOTH_PRICES=sheet:2000,pose:2500,style:2500,party:4000
# Email guests their sticker (Resend, needs RESEND_API_KEY + a verified domain).
BOOTH_EMAIL_FROM=MeSticker <stickers@mesticker.fun>
# 1 = skip payment (demos). Staff can also toggle this in the hidden staff panel.
NEXT_PUBLIC_BOOTH_FREE_MODE=
# Shown in Stripe metadata so sales can be split per booth.
BOOTH_ID=booth-1
# Image model for the booth: openai (default) | gemini | fal
BOOTH_IMAGE_PROVIDER=openai
# Booth stickers match the web app (quality medium). Optional overrides:
#   BOOTH_PREVIEW_QUALITY=low  → faster but rougher
#   BOOTH_PRINT_QUALITY=high   → also make a sharper copy in the background for printing
BOOTH_PREVIEW_QUALITY=
BOOTH_PRINT_QUALITY=
# Google "Nano Banana 2" — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=
# FLUX Kontext on fal.ai — https://fal.ai/dashboard/keys
FAL_KEY=
FAL_MODEL=fal-ai/flux-pro/kontext
